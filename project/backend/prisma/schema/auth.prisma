model Session {
    id             String   @id @default(uuid()) @db.Uuid
    expiresAt      DateTime
    token          String   @unique
    ipAddress      String?
    userAgent      String?
    impersonatedBy String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    userId         String   @db.Uuid
    users          User     @relation(fields: [userId], references: [id])

    @@index([userId])
    @@map("session")
}

model Verification {
    id         String   @id @default(uuid()) @db.Uuid
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt

    @@index([identifier])
    @@map("verification")
}

enum PROVIDERS {
    USER
    GOOGLE
    GITHUB
}

//storing all auth providers
model AuthProvider {
    id        String    @id @default(uuid()) @db.Uuid
    provider  PROVIDERS
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt

    accountId String  @unique @db.Uuid
    account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@unique([accountId, provider])
    @@index([accountId])
    @@map("authProvider")
}
